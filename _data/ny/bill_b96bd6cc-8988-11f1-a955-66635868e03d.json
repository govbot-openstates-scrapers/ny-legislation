{"legislative_session": "2025-2026", "identifier": "A3926", "title": "Relates to enacting the medical civil rights act", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Enacts the medical civil rights act; provides that persons in the custody or control of a law enforcement officer, police officer, peace officer, correctional officer, or other law enforcement representative or entity who are experiencing an emergency medical condition or is medically unstable have the right to be provided with emergency medical services and that such officers, representatives, and entities have a duty to provide such services; provides an exception to such duty to provide emergency medical services."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-a3926"}], "actions": [{"description": "REFERRED TO CODES", "date": "2025-01-30", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "CODES", "entity_type": "organization", "organization_id": null}]}, {"description": "REFERRED TO CODES", "date": "2026-01-07", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "CODES", "entity_type": "organization", "organization_id": null}]}, {"description": "AMEND AND RECOMMIT TO CODES", "date": "2026-04-14", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["amendment-passage", "referral-committee"], "related_entities": []}, {"description": "PRINT NUMBER 3926A", "date": "2026-04-14", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["amendment-passage"], "related_entities": []}], "sponsorships": [{"name": "Phara Souffrant Forrest", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Phara Souffrant Forrest\"}", "organization_id": null}], 