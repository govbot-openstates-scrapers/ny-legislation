{"legislative_session": "2025-2026", "identifier": "A11723", "title": "Relates to the use of artificial intelligence and attorney-client privilege and work product", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Provides that a communication or attorney work product otherwise protected by the attorney-client privilege or which otherwise shall not be obtainable by another party shall not lose its privileged or unobtainable character solely as a result of it being produced by, transmitted to, processed by, stored on, or otherwise facilitated through an artificial intelligence technology; requires authorization from the client to utilize artificial intelligence."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-a11723"}], "actions": [{"description": "REFERRED TO JUDICIARY", "date": "2026-09-16", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "JUDICIARY", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Rules Committee", "classification": "primary", "entity_type": "organization", "primary": true, "person_id": null, "organization_id": "~{\"name\": \"Rules Committee\"}"}], "related_bills": [], "versions": [{"note": "A11723", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=A11723&term=2025&Text=Y", "media_type": "text/html"}, {"url": "http://legislation.nysenate.gov/pdf/bills/2025/A11723", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [{"publication": "New York Laws", "citation": "CVP \u00a7 4552", "citation_type": "proposed", "effective": null, "expires": null, "url": "https://www.nysenate.gov/legislation/laws/CVP/"}], "sources": [{"url": "https://legislation.nysenate.gov/api/3/bills/2025-2026/A11723?summary=&detail=", "note": ""}, {"url": "http://www.nysen