{"legislative_session": "2025-2026", "identifier": "A11197", "title": "Enacts the \"fair authorized investment returns act\"", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Enacts the \"fair authorized investment returns act\"; sets a default authorized return on equity equal to the ten year US Treasury rate plus two hundred basis points; provides such default authorized return shall reset annually; establishes a competitive equity auction through which the cost of equity for a covered utility may be determined on a market basis, whether initiated by the utility or ordered by the commission."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-a11197"}], "actions": [{"description": "REFERRED TO CORPORATIONS, AUTHORITIES AND COMMISSIONS", "date": "2026-05-01", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "CORPORATIONS, AUTHORITIES AND COMMISSIONS", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Sarahana Shrestha", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Sarahana Shrestha\"}", "organization_id": null}], "related_bills": [{"identifier": "S 10424", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "S 10424", "legislative_session": "2025-2026", "relation_type": "companion"}], "versions": [{"note": "A11197", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=A11197&term=2025&Text=Y", "media_type": "text/html"}, {"url": "http://legislation.nysenate.gov/pdf/bills/2025/A11197", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [{"publication": "New York Laws", "citation": "PBS \u00a7 A1-A", "citation_type": "proposed", "effective": null, "expires": null, "url": "https://www.ny