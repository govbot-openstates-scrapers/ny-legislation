{"legislative_session": "2025-2026", "identifier": "A10764", "title": "Establishes utility billing integrity requirements and consumer protections", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Enacts the \"utility billing integrity act\" to establish utility billing integrity and consumer protections through anomaly detection, advanced data analytics and the usage of artificial intelligence; requires every utility to implement and maintain a billing integrity program utilizing anomaly detection systems to review all residential utility bills prior to issuance; provides that where a billing anomaly is identified, the utility shall provide prompt notice to the customer that the bill is under review."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-a10764"}], "actions": [{"description": "REFERRED TO ENERGY", "date": "2026-04-01", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "ENERGY", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Jake Ryan Blumencranz", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Jake Ryan Blumencranz\"}", "organization_id": null}], "related_bills": [], "versions": [{"note": "A10764", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=A10764&term=2025&Text=Y", "media_type": "text/html"}, {"url": "http://legislation.nysenate.gov/pdf/bills/2025/A10764", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [], "sources": [{"url": "https://legislation.nysenate.gov/api/3/bills/2025-2026/A10764?summary=&detail=", "note": ""}, {"url": "http://www.nysenate.gov/legislation/bills/2025/A10764", "note": ""}, {"url": "https://nyassembly.gov/leg/?bn=A10764&term=2025", "note": ""}], "extras": {}, "jur