{"legislative_session": "2025-2026", "identifier": "S8826", "title": "Provides a rebuttable presumption relating to recertification as a minority and women-owned business enterprise", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Provides a rebuttable presumption relating to recertification as a minority and women-owned business enterprise if there is no change in the ownership or capital contribution relied upon for certification of the enterprise and no material change in the nature or management of the enterprise from the time of approval of the previous minority and women-owned business enterprise certification."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-s8826"}], "actions": [{"description": "REFERRED TO RULES", "date": "2026-01-08", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": [{"name": "RULES", "entity_type": "organization", "organization_id": null}]}, {"description": "ORDERED TO THIRD READING CAL.93", "date": "2026-01-20", "organization_id": "~{\"classification\": \"upper\"}", "classification": [], "related_entities": []}, {"description": "SUBSTITUTED BY A9451", "date": "2026-01-28", "organization_id": "~{\"classification\": \"upper\"}", "classification": [], "related_entities": []}], "sponsorships": [{"name": "Michelle Hinchey", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Michelle Hinchey\"}", "organization_id": null}, {"name": "Dean Murray", "classification": "cosponsor", "entity_type": "person", "primary": false, "person_id": "~{\"name\": \"Dean Murray\"}", "organization_id": null}], "related_bills": [{"identifier": "A 9451", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "A 9451", "legislative_session": "2025-2026", "relation_type": "companion"}], "versions": [{"n