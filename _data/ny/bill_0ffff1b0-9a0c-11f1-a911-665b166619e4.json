{"legislative_session": "2025-2026", "identifier": "A11232", "title": "Extends the authorization of the city of Dunkirk to issue bonds and requires such city to adhere to all collective bargaining agreements entered into", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Extends the authorization of the city of Dunkirk to issue bonds under the city of Dunkirk fiscal recovery act until 2026; requires the city of Dunkirk to adhere to all collective bargaining agreements entered into; directs the city to adopt a local law approving the city of Dunkirk fiscal recovery act; provides that if the city treasurer position is no longer active, the mayor of the city of Dunkirk shall handle the requirements of the former city treasurer."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-a11232"}], "actions": [{"description": "REFERRED TO CITIES", "date": "2026-05-01", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "CITIES", "entity_type": "organization", "organization_id": null}]}, {"description": "AMEND (T) AND RECOMMIT TO CITIES", "date": "2026-05-12", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["amendment-passage", "referral-committee"], "related_entities": []}, {"description": "PRINT NUMBER 11232A", "date": "2026-05-12", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["amendment-passage"], "related_entities": []}], "sponsorships": [{"name": "Andrew Molitor", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Andrew Molitor\"}", "organization_id": null}], "related_bills": [{"identifier": "S 10129", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "S 10129", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "A