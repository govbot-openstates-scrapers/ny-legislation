{"legislative_session": "2025-2026", "identifier": "S9634", "title": "Requires limited services pregnancy centers to disclose to clients that they do not have a licensed medical provider on staff", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Requires limited services pregnancy centers to disclose to clients that they do not have a licensed medical provider on staff who provides or supervises reproductive health services at such center; requires such disclosure to be provided in writing and orally, and to be available in English and Spanish; provides for reporting of violations; provides penalties for violations."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-s9634"}], "actions": [{"description": "REFERRED TO WOMEN'S ISSUES", "date": "2026-03-31", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": [{"name": "WOMEN'S ISSUES", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Michelle Hinchey", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Michelle Hinchey\"}", "organization_id": null}], "related_bills": [{"identifier": "A 4338", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "A 4338", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "S 2692", "legislative_session": "2025-2026", "relation_type": "prior-session"}, {"identifier": "S 9400", "legislative_session": "2023-2024", "relation_type": "prior-session"}], "versions": [{"note": "S9634", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=S9634&term=2025&Text=Y", "media_type": "text/html"}, {"url": "http://legislation.nysenate.gov/pdf/bills/2025/S9634", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations":