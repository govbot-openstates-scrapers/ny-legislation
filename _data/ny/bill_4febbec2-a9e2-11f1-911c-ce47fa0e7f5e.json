{"legislative_session": "2025-2026", "identifier": "A11669", "title": "Enacts the \"Fostering Optimal Classroom Use of Screens (FOCUS) act\" to limit use of internet enabled devices and prioritize non-digital teaching methods", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Enacts the \"fostering optimal classroom use of screens (FOCUS) act\" to limit use of internet enabled and electronic devices and prioritize non-digital teaching methods; prohibits use by younger students; limits and restricts certain uses by older students; requires written policies for opting in for the school issued devices; prohibits social media applications, gaming and AI in school issued devices; requires registration by educational technology providers."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-a11669"}], "actions": [{"description": "REFERRED TO EDUCATION", "date": "2026-09-02", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "EDUCATION", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Rules Committee", "classification": "primary", "entity_type": "organization", "primary": true, "person_id": null, "organization_id": "~{\"name\": \"Rules Committee\"}"}], "related_bills": [{"identifier": "S 10685", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "S 10685", "legislative_session": "2025-2026", "relation_type": "companion"}], "versions": [{"note": "A11669", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=A11669&term=2025&Text=Y", "media_type": "text/html"}, {"url": "http://legislation.nysenate.gov/pdf/bills/2025/A11669", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [{"publication": "New York Laws", "citation": "EDN \u00a7 A2-B", "citatio