{"legislative_session": "2025-2026", "identifier": "S10107", "title": "Requires signage be placed alongside art and artifacts stolen during the transatlantic slave period and the domestic slave trade period indicating such material was stolen", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Requires signage be placed alongside art and artifacts, including art and artifacts created using metal materials used in the exchange for enslaved human captives, which were stolen during the transatlantic slave period and the domestic slave trade period, between the 16th and 19th centuries, with its peak between 1700 and 1870, indicating such information."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-s10107"}], "actions": [{"description": "REFERRED TO EDUCATION", "date": "2026-04-29", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": [{"name": "EDUCATION", "entity_type": "organization", "organization_id": null}]}, {"description": "AMEND AND RECOMMIT TO EDUCATION", "date": "2026-05-29", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["amendment-passage", "referral-committee"], "related_entities": []}, {"description": "PRINT NUMBER 10107A", "date": "2026-05-29", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["amendment-passage"], "related_entities": []}], "sponsorships": [{"name": "Lea Webb", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Lea Webb\"}", "organization_id": null}], "related_bills": [{"identifier": "A 8192", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "A 8192", "legislative_session": "2025-2026", "relation_type": "companion"}], "versions": [{"note": "S10107", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=S10107