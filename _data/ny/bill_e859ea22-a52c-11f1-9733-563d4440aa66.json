{"legislative_session": "2025-2026", "identifier": "A3941", "title": "Establishes a public awareness campaign concerning the dangers of social media and cell phone use by school-age children", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Directs the commissioner of mental health to establish a public awareness campaign concerning the dangers of social media and cell phone use by school-age children, including but not limited to the addictive qualities of social media, the stunting impact of social media usage on the development of social skills, increased feelings of isolation, anxiety and depression among adolescent users and the attendant amplification of peer on peer bullying, and increased rates of adolescent suicide and suicide attempts, as well as about how to recognize suicide risk factors and seek suicide prevention assistance."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-a3941"}], "actions": [{"description": "REFERRED TO MENTAL HEALTH", "date": "2025-01-30", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "MENTAL HEALTH", "entity_type": "organization", "organization_id": null}]}, {"description": "REFERRED TO MENTAL HEALTH", "date": "2026-01-07", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "MENTAL HEALTH", "entity_type": "organization", "organization_id": null}]}, {"description": "REPORTED REFERRED TO WAYS AND MEANS", "date": "2026-03-10", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "WAYS AND MEANS", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Carrie Woerner", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "