{"legislative_session": "2025-2026", "identifier": "A11722", "title": "Requires hospitals to provide disposable diapers and wipes and infant formula for newborns and menstrual products at the time of discharge", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Requires hospitals which provide maternity services to provide disposable diapers and wipes and offer a one-week supply of infant formula for newborns, and to provide a supply of menstrual products, at the time of discharge; clarifies that offering and providing such infant formula shall not affect a hospital's eligibility to participate in the department of health's breastfeeding friendly practice designation program."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-a11722"}], "actions": [{"description": "REFERRED TO HEALTH", "date": "2026-09-16", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "HEALTH", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Rules Committee", "classification": "primary", "entity_type": "organization", "primary": true, "person_id": null, "organization_id": "~{\"name\": \"Rules Committee\"}"}], "related_bills": [], "versions": [{"note": "A11722", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=A11722&term=2025&Text=Y", "media_type": "text/html"}, {"url": "http://legislation.nysenate.gov/pdf/bills/2025/A11722", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [{"publication": "New York Laws", "citation": "PBH \u00a7 2833", "citation_type": "proposed", "effective": null, "expires": null, "url": "https://www.nysenate.gov/legislation/laws/PBH/"}], "sources": [{"url": "https://legislation.nysenate.gov/api/3/bills/2025-2026/A11722?summary=&detail=", "note": ""}, {"url": "http://ww