{"legislative_session": "2025-2026", "identifier": "A8036", "title": "Requires commissioners of local social services districts to screen, apply for, and use and conserve federal benefits on behalf of children placed in foster care", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Requires commissioners of local social services districts to screen, apply for, and use and conserve retirement, survivors and disability insurance, supplemental security income, veterans' or any other federal social security benefits on behalf of certain children; provides for responsibilities of local commissioners of social services appointed to serve as the representative payee for a child; provides for technical assistance and financial literacy for certain children; makes related provisions."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-a8036"}], "actions": [{"description": "REFERRED TO SOCIAL SERVICES", "date": "2025-04-22", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "SOCIAL SERVICES", "entity_type": "organization", "organization_id": null}]}, {"description": "REFERRED TO SOCIAL SERVICES", "date": "2026-01-07", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "SOCIAL SERVICES", "entity_type": "organization", "organization_id": null}]}, {"description": "REPORTED REFERRED TO WAYS AND MEANS", "date": "2026-05-27", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "WAYS AND MEANS", "entity_type": "organization", "organization_id": null}]}, {"description": "AMEND (T) AND RECOMMIT TO WAYS AND MEANS", "date": "2026-05-29", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["amendment-passage", "referral-c