{"legislative_session": "2025-2026", "identifier": "S8102", "title": "Relates to requiring manufacturers of internet-enabled devices to conduct age assurance to determine a user's age category", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Requires manufacturers of internet-enabled devices to conduct age assurance to determine a user's age category and provide all websites, online services, online applications and mobile applications on such user's internet-enabled device and/or application store manufactured by the covered manufacturer with a digital signal that such user is a covered minor as well as the age category of such covered minor via a real-time application programming interface (API)."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-s8102"}], "actions": [{"description": "REFERRED TO CONSUMER PROTECTION", "date": "2025-05-15", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": [{"name": "CONSUMER PROTECTION", "entity_type": "organization", "organization_id": null}]}, {"description": "REFERRED TO CONSUMER PROTECTION", "date": "2026-01-07", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": [{"name": "CONSUMER PROTECTION", "entity_type": "organization", "organization_id": null}]}, {"description": "AMEND AND RECOMMIT TO CONSUMER PROTECTION", "date": "2026-02-25", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["amendment-passage", "referral-committee"], "related_entities": []}, {"description": "PRINT NUMBER 8102A", "date": "2026-02-25", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["amendment-passage"], "related_entities": []}, {"description": "AMEND AND RECOMMIT TO CONSUMER PROTECTION", "date": "2026-05-15", "organization_id": "~{\"classification\