{"legislative_session": "2025-2026", "identifier": "S8907", "title": "Relates to the failure of certain utilities and the Long Island power authority to achieve annual customer service performance targets", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Enacts the \"utility penalty and customer bill relief act\"; requires every gas corporation, electric corporation, combination gas and electric corporation, water-works corporation and the Long Island power authority which fails to achieve annual customer service performance targets in a particular year, which are subject to financial penalties or negative revenue adjustments to return such penalties or adjustments to rate payers as a direct bill credit."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-s8907"}], "actions": [{"description": "REFERRED TO ENERGY AND TELECOMMUNICATIONS", "date": "2026-01-14", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": [{"name": "ENERGY AND TELECOMMUNICATIONS", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Leroy Comrie", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Leroy Comrie\"}", "organization_id": null}], "related_bills": [{"identifier": "A 10423", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "A 10423", "legislative_session": "2025-2026", "relation_type": "companion"}], "versions": [{"note": "S8907", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=S8907&term=2025&Text=Y", "media_type": "text/html"}, {"url": "http://legislation.nysenate.gov/pdf/bills/2025/S8907", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [{"publication": "New York Laws", "citation": "PBS \u00a7 25-B", "citation_ty