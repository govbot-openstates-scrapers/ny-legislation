{"legislative_session": "2025-2026", "identifier": "A10556", "title": "Relates to orders of protection where the respondent is a minor who resides with a parent or other legally responsible person or other party", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Relates to orders of protection where the respondent is a minor who resides with a parent or other legally responsible person or other party; prohibits courts from issuing an order of protection that directs a minor respondent to stay away from the home of a parent or other person legally responsible for the respondent if the respondent would not have an appropriate alternative residence; provides that such a respondent shall have the right to have a guardian ad litem appointed, if appropriate; authorizes suspended judgment in certain cases provided that the respondent participate in a batterer's education program."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-a10556"}], "actions": [{"description": "REFERRED TO CHILDREN AND FAMILIES", "date": "2026-03-13", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "CHILDREN AND FAMILIES", "entity_type": "organization", "organization_id": null}]}, {"description": "REPORTED REFERRED TO CODES", "date": "2026-05-27", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "CODES", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Andrew Hevesi", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Andrew Hevesi\"}", "organization_id": null}], "related_bills": [{"identifier": "S 9354", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "S 9354", "legislative_session": "2025-2026", "relati