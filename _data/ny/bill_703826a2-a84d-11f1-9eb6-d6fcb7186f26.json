{"legislative_session": "2025-2026", "identifier": "S9503", "title": "Enacts the \"End the Toll Trap: Real Relief for Drivers Act\"", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Enacts the \"End the Toll Trap: Real Relief for Drivers Act\" to address excess administrative costs incurred by public authorities for the collection of toll payments and to ensure repeat toll evaders pay such costs; creates the New York and New Jersey toll and fees reduction task force to examine and evaluate the efficacy of current payment processing procedures and systems, and to provide recommendations to increase efficacy and reduce tolls and administrative fees."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-s9503"}], "actions": [{"description": "REFERRED TO TRANSPORTATION", "date": "2026-03-18", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": [{"name": "TRANSPORTATION", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Monica Martinez", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Monica Martinez\"}", "organization_id": null}, {"name": "Cordell Cleare", "classification": "cosponsor", "entity_type": "person", "primary": false, "person_id": "~{\"name\": \"Cordell Cleare\"}", "organization_id": null}, {"name": "Leroy Comrie", "classification": "cosponsor", "entity_type": "person", "primary": false, "person_id": "~{\"name\": \"Leroy Comrie\"}", "organization_id": null}, {"name": "Michelle Hinchey", "classification": "cosponsor", "entity_type": "person", "primary": false, "person_id": "~{\"name\": \"Michelle Hinchey\"}", "organization_id": null}, {"name": "Steve Rhoads", "classification": "cosponsor", "entity_type": "person", "primary": false, "person_id": "~{\"name\": \"Steve Rhoads\"}", "organizatio