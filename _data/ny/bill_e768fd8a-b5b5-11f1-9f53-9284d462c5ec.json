{"legislative_session": "2025-2026", "identifier": "A11717", "title": "Relates to compensation received by minor student-athletes from contracts for the use of a student-athlete's name, image and likeness", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Requires that if compensation in excess of ten thousand dollars per year is paid to a student-athlete who is a minor from contracts for the use of the student-athlete's name, image and likeness, all amounts in excess of ten thousand dollars must be deposited into a restricted trust account established for the benefit of the student-athlete."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-a11717"}], "actions": [{"description": "REFERRED TO HIGHER EDUCATION", "date": "2026-09-16", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "HIGHER EDUCATION", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Rules Committee", "classification": "primary", "entity_type": "organization", "primary": true, "person_id": null, "organization_id": "~{\"name\": \"Rules Committee\"}"}], "related_bills": [], "versions": [{"note": "A11717", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=A11717&term=2025&Text=Y", "media_type": "text/html"}, {"url": "http://legislation.nysenate.gov/pdf/bills/2025/A11717", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [{"publication": "New York Laws", "citation": "EDN \u00a7 6438-C", "citation_type": "proposed", "effective": null, "expires": null, "url": "https://www.nysenate.gov/legislation/laws/EDN/"}], "sources": [{"url": "https://legislation.nysenate.gov/api/3/bills/2025-2026/A11717?summary=&detail=", "note": ""}, {"url": "http://www.nysenate.gov/legislation/bills/2025/A11717", "note": ""}, {"u