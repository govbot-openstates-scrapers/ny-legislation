{"legislative_session": "2025-2026", "identifier": "A11721", "title": "Relates to infant head support labeling", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Requires any infant head support device offered for sale in the state of New York to provide a clear and conspicuous warning on such device and its retail packaging that prolonged use of such product may cause flattening, molding, or deformation of a baby's skull and that the recipient of such infant head support device should limit the time their baby spends resting against the product and to reposition their baby frequently."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-a11721"}], "actions": [{"description": "REFERRED TO CONSUMER AFFAIRS AND PROTECTION", "date": "2026-09-16", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "CONSUMER AFFAIRS AND PROTECTION", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Rules Committee", "classification": "primary", "entity_type": "organization", "primary": true, "person_id": null, "organization_id": "~{\"name\": \"Rules Committee\"}"}], "related_bills": [], "versions": [{"note": "A11721", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=A11721&term=2025&Text=Y", "media_type": "text/html"}, {"url": "http://legislation.nysenate.gov/pdf/bills/2025/A11721", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [{"publication": "New York Laws", "citation": "GBS \u00a7 399-AAAAAAA", "citation_type": "proposed", "effective": null, "expires": null, "url": "https://www.nysenate.gov/legislation/laws/GBS/"}], "sources": [{"url": "https://legislation.nysenate.gov/api/3/bills/2025-2026/A11721?summary=&detail=", "note": ""}, {"url": "http://www.nysenate.gov/legislation/bills/2