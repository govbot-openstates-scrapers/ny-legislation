{"legislative_session": "2025-2026", "identifier": "S9718", "title": "Relates to the provision of legal representation to certain persons in eviction, ejectment and foreclosure proceedings", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Requires counties and/or cities to establish a plan for providing legal counsel to persons who are defendants or respondents in eviction, ejectment and foreclosure proceedings and who are financially unable to obtain counsel; defines eligible person as one whose gross individual income is not in excess of one hundred twenty-five percent of the federal income official poverty line; requires the state to match dollar for dollar the amount counties appropriate for their plans."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-s9718"}], "actions": [{"description": "REFERRED TO LOCAL GOVERNMENT", "date": "2026-04-02", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": [{"name": "LOCAL GOVERNMENT", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Cordell Cleare", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Cordell Cleare\"}", "organization_id": null}], "related_bills": [{"identifier": "A 162", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "A 162", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "S 7436", "legislative_session": "2025-2026", "relation_type": "prior-session"}, {"identifier": "S 3299", "legislative_session": "2023-2024", "relation_type": "prior-session"}, {"identifier": "S 1727", "legislative_session": "2021-2022", "relation_type": "prior-session"}, {"identifier": "S 3418", "legislative_session": "2019-2020", "relation_type": "prior-session"}, {"identifier": "S 792", "legislat