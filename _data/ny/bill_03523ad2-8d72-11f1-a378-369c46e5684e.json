{"legislative_session": "2025-2026", "identifier": "A10667", "title": "Defines lease-hold retirement community and proscribes rules and regulations for ownership and operation thereof", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Sets up rules and regulations for the operation of lease-hold retirement communities located in a county with a population of more than one million inhabitants that only borders one other county, to provide adequate housing for senior citizens wishing to retire and locate in a lease-hold retirement community; grants owners of homes in lease-hold retirement communities the right to sell their homes by methods common to sales of residential property; requires that owners of lease-hold retirement communities offer owners of homes the option to sign a long-term ninety-nine year lease."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-a10667"}], "actions": [{"description": "REFERRED TO HOUSING", "date": "2026-03-20", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "HOUSING", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Jodi Giglio", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Jodi Giglio\"}", "organization_id": null}], "related_bills": [{"identifier": "S 7343", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "S 7343", "legislative_session": "2025-2026", "relation_type": "companion"}], "versions": [{"note": "A10667", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=A10667&term=2025&Text=Y", "media_type": "text/html"}, {"url": "http://legislation.nysenate.gov/pdf/bills/2025/A10667", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [], "sources"