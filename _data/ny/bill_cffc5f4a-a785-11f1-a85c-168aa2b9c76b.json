{"legislative_session": "2025-2026", "identifier": "S10055", "title": "Prohibits certain surcharges on credit or debit card transactions", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Prohibits certain surcharges on certain credit or debit card transactions in the city of New York; provides that no agency or department of the city of New York, or any tribunal located therein, shall be authorized to impose a surcharge on a holder who elects to use a credit or debit card in lieu of payment by cash, check, or similar means to pay any fine, civil penalty, or fee owed."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-s10055"}], "actions": [{"description": "REFERRED TO CITIES 1", "date": "2026-04-24", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": [{"name": "CITIES 1", "entity_type": "organization", "organization_id": null}]}, {"description": "REPORTED AND COMMITTED TO FINANCE", "date": "2026-05-14", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": []}], "sponsorships": [{"name": "Sam Sutton", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Sam Sutton\"}", "organization_id": null}, {"name": "Jessica Ramos", "classification": "cosponsor", "entity_type": "person", "primary": false, "person_id": "~{\"name\": \"Jessica Ramos\"}", "organization_id": null}], "related_bills": [{"identifier": "A 111", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "A 111", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "S 2570", "legislative_session": "2025-2026", "relation_type": "prior-session"}, {"identifier": "S 1378", "legislative_session": "2023-2024", "relation_type": "prior-session"}, {"identifier": "S 3694