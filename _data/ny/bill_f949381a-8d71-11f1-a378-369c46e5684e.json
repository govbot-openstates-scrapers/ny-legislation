{"legislative_session": "2025-2026", "identifier": "S8763", "title": "Relates to the method of notifying certain crime victims of the disposition of criminal trial", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Requires that following the acquittal after trial or the sentencing of any defendant for a felony, the district attorney, or their designee, shall provide by mail, electronically, or by any other reasonable and secure means of written communication a written summary of the disposition of such felony to any victim who was not present at the time that the defendant was sentenced or acquitted after trial."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-s8763"}], "actions": [{"description": "REFERRED TO RULES", "date": "2026-01-08", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": [{"name": "RULES", "entity_type": "organization", "organization_id": null}]}, {"description": "ORDERED TO THIRD READING CAL.62", "date": "2026-01-20", "organization_id": "~{\"classification\": \"upper\"}", "classification": [], "related_entities": []}, {"description": "PASSED SENATE", "date": "2026-01-21", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["passage"], "related_entities": []}, {"description": "DELIVERED TO ASSEMBLY", "date": "2026-01-21", "organization_id": "~{\"classification\": \"upper\"}", "classification": [], "related_entities": []}, {"description": "REFERRED TO CODES", "date": "2026-01-21", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "CODES", "entity_type": "organization", "organization_id": null}]}, {"description": "SUBSTITUTED FOR A9493", "date": "2026-02-03", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}, {"d