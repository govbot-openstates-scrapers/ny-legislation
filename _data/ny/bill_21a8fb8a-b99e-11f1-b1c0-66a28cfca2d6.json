{"legislative_session": "2025-2026", "identifier": "A11720", "title": "Prohibits operators of a website, application, software, program, or service from allowing users to nudify a still or video image", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Prohibits operators of a website, application, software, program, or service from allowing users to nudify a still or video image; prohibits advertising or promoting websites, applications, software, programs, or services that allow users to nudify a still or video image; provides an exception when technical skill is required to nudify an image; establishes penalties for violations of such provisions; establishes the nudification prohibition recoveries services fund to provide grants to support the direct needs of victims of sexual assault, domestic violence, and child abuse."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-a11720"}], "actions": [{"description": "REFERRED TO SCIENCE AND TECHNOLOGY", "date": "2026-09-16", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "SCIENCE AND TECHNOLOGY", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Rules Committee", "classification": "primary", "entity_type": "organization", "primary": true, "person_id": null, "organization_id": "~{\"name\": \"Rules Committee\"}"}], "related_bills": [{"identifier": "S 10676", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "S 10676", "legislative_session": "2025-2026", "relation_type": "companion"}], "versions": [{"note": "A11720", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=A11720&term=2025&Text=Y", "media_type": "text/html"}, {"url": "http://legislation.nysenate.gov/pdf/bills/2025/A11720", "media_type": "application/pdf"}], "date": "", "classifi