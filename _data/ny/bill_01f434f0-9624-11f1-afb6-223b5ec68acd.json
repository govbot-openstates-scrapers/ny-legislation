{"legislative_session": "2025-2026", "identifier": "A11646", "title": "Relates to political communication", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Provides that any person, firm, association, corporation, campaign, committee, or organization found guilty of knowingly disseminating or publishing media without the consent of the person depicted and who knew or should have known that it was materially deceptive shall forfeit to the state board of elections a sum not exceeding ten thousand dollars for each and every offense and three times the total amount spent on creating and promoting the materially deceptive media."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-a11646"}], "actions": [{"description": "REFERRED TO ELECTION LAW", "date": "2026-07-29", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "ELECTION LAW", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Rules Committee", "classification": "primary", "entity_type": "organization", "primary": true, "person_id": null, "organization_id": "~{\"name\": \"Rules Committee\"}"}], "related_bills": [], "versions": [{"note": "A11646", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=A11646&term=2025&Text=Y", "media_type": "text/html"}, {"url": "http://legislation.nysenate.gov/pdf/bills/2025/A11646", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [], "sources": [{"url": "https://legislation.nysenate.gov/api/3/bills/2025-2026/A11646?summary=&detail=", "note": ""}, {"url": "http://www.nysenate.gov/legislation/bills/2025/A11646", "note": ""}, {"url": "https://nyassembly.gov/leg/?bn=A11646&term=2025", "note": ""}], "extras": {}, "jurisdiction": {"id": "ocd-jurisdiction/country:us/state:ny/government", "na