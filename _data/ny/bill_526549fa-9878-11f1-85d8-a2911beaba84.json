{"legislative_session": "2025-2026", "identifier": "S10349", "title": "Prohibits the department of corrections and community supervision from using artificial intelligence in parole determinations", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Prohibits the department of corrections and community supervision from using artificial intelligence in evaluating the risk and needs principles used to measure rehabilitation of a person, in determining which incarcerated individuals may be released on parole or the level of supervision for individuals on parole; prohibits the department from using artificial intelligence when developing transitional accountability plans."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-s10349"}], "actions": [{"description": "REFERRED TO CRIME VICTIMS, CRIME AND CORRECTION", "date": "2026-05-14", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": [{"name": "CRIME VICTIMS, CRIME AND CORRECTION", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Shelley Mayer", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Shelley Mayer\"}", "organization_id": null}], "related_bills": [{"identifier": "A 11320", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "A 11320", "legislative_session": "2025-2026", "relation_type": "companion"}], "versions": [{"note": "S10349", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=S10349&term=2025&Text=Y", "media_type": "text/html"}, {"url": "http://legislation.nysenate.gov/pdf/bills/2025/S10349", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [{"publication": "New York Laws", "citation": "COR \u00a7 71-A", "citation_type": "proposed", "effe