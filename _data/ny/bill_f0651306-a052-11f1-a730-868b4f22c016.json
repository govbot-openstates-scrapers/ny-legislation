{"legislative_session": "2025-2026", "identifier": "S10676", "title": "Prohibits operators of a website, application, software, program, or service from allowing users to nudify a still or video image", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Prohibits operators of a website, application, software, program, or service from allowing users to nudify a still or video image; prohibits advertising or promoting websites, applications, software, programs, or services that allow users to nudify a still or video image; provides an exception when technical skill is required to nudify an image; establishes penalties for violations of such provisions; establishes the nudification prohibition recoveries services fund to provide grants to support the direct needs of victims of sexual assault, domestic violence, and child abuse."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-s10676"}], "actions": [{"description": "REFERRED TO RULES", "date": "2026-08-10", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": [{"name": "RULES", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Michelle Hinchey", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Michelle Hinchey\"}", "organization_id": null}], "related_bills": [], "versions": [{"note": "S10676", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=S10676&term=2025&Text=Y", "media_type": "text/html"}, {"url": "http://legislation.nysenate.gov/pdf/bills/2025/S10676", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [{"publication": "New York Laws", "citation": "GBS \u00a7 A44-C", "citation_type": "proposed", "effective": null, "expires": null, "url": "https://www.nysenate.gov/legislation/l