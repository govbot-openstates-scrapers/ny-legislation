{"legislative_session": "2025-2026", "identifier": "S10692", "title": "Relates to the disclosure of artificial intelligence use in floor statements and debate by members of the legislature", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Enacts the \"compulsory artificial narrative disclosure for official rhetoric (CANDOR) act\" in relation to requiring any member of the senate or assembly that rises to speak, read a statement, or enter comments into the official legislative record to verbally state a standard disclosure prior to delivering such remarks if such remarks were drafted in whole or in part by artificial intelligence or generative artificial intelligence."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-s10692"}], "actions": [{"description": "REFERRED TO RULES", "date": "2026-09-09", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": [{"name": "RULES", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Stephen T. Chan", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Stephen T. Chan\"}", "organization_id": null}], "related_bills": [{"identifier": "A 11684", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "A 11684", "legislative_session": "2025-2026", "relation_type": "companion"}], "versions": [{"note": "S10692", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=S10692&term=2025&Text=Y", "media_type": "text/html"}, {"url": "http://legislation.nysenate.gov/pdf/bills/2025/S10692", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [{"publication": "New York Laws", "citation": "LEG \u00a7 7-H", "citation_type": "proposed", "effective": null, "expires": null, "url": "https://www.nyse