{"legislative_session": "2025-2026", "identifier": "A9388", "title": "Requires that businesses offering physical manipulation services ensure clear visibility from the public right-of-way into certain public spaces on the premises of such businesses", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Requires that businesses offering physical manipulation services ensure that certain windows, entrances, and public-facing areas are unobscured and that there is clear visibility from the public right-of-way into certain public spaces on the premises of such businesses; defines physical manipulation services to include massage therapy, reflexology, services provided on feet at foot spas, bodywork, acupressure, and any other service that involves physically manipulating any part of a human body; exempts services provided by certain persons from being included in such definition."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-a9388"}], "actions": [{"description": "REFERRED TO ECONOMIC DEVELOPMENT", "date": "2025-12-19", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "ECONOMIC DEVELOPMENT", "entity_type": "organization", "organization_id": null}]}, {"description": "REFERRED TO ECONOMIC DEVELOPMENT", "date": "2026-01-07", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "ECONOMIC DEVELOPMENT", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Larinda Hooks", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Larinda Hooks\"}", "organization_id": null}], "related_bills": [], "versions": [{"note": "A9388", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=A9388&term=2025&Text=Y", "media_type": "