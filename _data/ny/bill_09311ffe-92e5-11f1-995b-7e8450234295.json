{"legislative_session": "2025-2026", "identifier": "S10157", "title": "Enacts the \"utility fair acquisition act\"", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Enacts the \"utility fair acquisition act\", providing that in any acquisition by a municipal corporation or a public benefit corporation created pursuant to article 5 of the public authorities law of infrastructure operated by a public utility company or private energy provider, the appraised value shall be reduced by the value of infrastructure that was financed through customer user fees, ratepayer surcharges, or other non-investor-funded mechanisms as determined by the public service commission."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-s10157"}], "actions": [{"description": "REFERRED TO LOCAL GOVERNMENT", "date": "2026-05-01", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": [{"name": "LOCAL GOVERNMENT", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Julia Salazar", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Julia Salazar\"}", "organization_id": null}], "related_bills": [{"identifier": "A 9154", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "A 9154", "legislative_session": "2025-2026", "relation_type": "companion"}], "versions": [{"note": "S10157", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=S10157&term=2025&Text=Y", "media_type": "text/html"}, {"url": "http://legislation.nysenate.gov/pdf/bills/2025/S10157", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [{"publication": "New York Laws", "citation": "PBA \u00a7 2859", "citation_type": "proposed", "effective": null, "expires": null, "url": "https