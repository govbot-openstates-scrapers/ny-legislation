{"legislative_session": "2025-2026", "identifier": "S10665", "title": "Enacts the \"Social Worker Initiative for Faster Testing (SWIFT) act\"", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Enacts the \"Social Worker Initiative for Faster Testing (SWIFT) act\"; provides that with respect to the examination requirement for licensure as a master social worker, an applicant pursuing a master's of social work degree who is enrolled in the final semester of a program registered by the department of education or an educational program accredited or in candidacy for accreditation by the council on social work education shall be eligible to take the master's level examination."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-s10665"}], "actions": [{"description": "REFERRED TO RULES", "date": "2026-07-22", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": [{"name": "RULES", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Michelle Hinchey", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Michelle Hinchey\"}", "organization_id": null}], "related_bills": [{"identifier": "A 11632", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "A 11632", "legislative_session": "2025-2026", "relation_type": "companion"}], "versions": [{"note": "S10665", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=S10665&term=2025&Text=Y", "media_type": "text/html"}, {"url": "http://legislation.nysenate.gov/pdf/bills/2025/S10665", "media_type": "application/pdf"}], "date": "", "classification": ""}], "documents": [], "citations": [{"publication": "New York Laws", "citation": "EDN \u00a7 7704", "citation_type": "proposed", "effective": null, "expires": null, "url": "https://w