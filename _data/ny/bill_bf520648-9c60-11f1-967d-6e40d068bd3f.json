{"legislative_session": "2025-2026", "identifier": "S8702", "title": "Prohibits the sale of any children's product, upholstered furniture or mattress that contains textile fiberglass", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Prohibits the sale of any children's product, upholstered furniture or mattress that contains textile fiberglass; prohibits any custom upholsterer from repairing, reupholstering, recovering, restoring or renewing upholstered furniture or reupholstered furniture using a replacement component that contains textile fiberglass, fibrous glass or glass wool."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-s8702"}], "actions": [{"description": "REFERRED TO ENVIRONMENTAL CONSERVATION", "date": "2026-01-07", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": [{"name": "ENVIRONMENTAL CONSERVATION", "entity_type": "organization", "organization_id": null}]}, {"description": "AMEND AND RECOMMIT TO ENVIRONMENTAL CONSERVATION", "date": "2026-05-19", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["amendment-passage", "referral-committee"], "related_entities": []}, {"description": "PRINT NUMBER 8702A", "date": "2026-05-19", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["amendment-passage"], "related_entities": []}], "sponsorships": [{"name": "Michelle Hinchey", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Michelle Hinchey\"}", "organization_id": null}], "related_bills": [{"identifier": "A 8537", "legislative_session": "2025-2026", "relation_type": "companion"}, {"identifier": "A 8537", "legislative_session": "2025-2026", "relation_type": "companion"}], "versions": [{"note": "S8702", "links": [{"url": "http://assembly.state.ny.us/leg/?sh=printbill&bn=S8702&t