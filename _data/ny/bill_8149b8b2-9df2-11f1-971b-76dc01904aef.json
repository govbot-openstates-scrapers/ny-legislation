{"legislative_session": "2025-2026", "identifier": "A8998", "title": "Enacts the \"dollars for diesels act\" relating to financial incentives for the retirement of certain heavy- and medium-duty diesel-powered vehicles", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Enacts the \"dollars for diesels act\"; directs the commissioner of environmental conservation, in consultation with the New York state energy research and development authority, to establish and administer a program to provide financial incentives to owners of heavy- and medium-duty diesel-powered vehicles of a model year two thousand ten or older to retire and replace such vehicles with new heavy- or medium-duty diesel-powered vehicles of model year two thousand twenty-four or newer that meet or exceed applicable emission standards."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-a8998"}], "actions": [{"description": "REFERRED TO ENVIRONMENTAL CONSERVATION", "date": "2025-08-13", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "ENVIRONMENTAL CONSERVATION", "entity_type": "organization", "organization_id": null}]}, {"description": "AMEND (T) AND RECOMMIT TO ENVIRONMENTAL CONSERVATION", "date": "2025-12-17", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["amendment-passage", "referral-committee"], "related_entities": []}, {"description": "PRINT NUMBER 8998A", "date": "2025-12-17", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["amendment-passage"], "related_entities": []}, {"description": "REFERRED TO ENVIRONMENTAL CONSERVATION", "date": "2026-01-07", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "ENVIRONMENTAL CONSERVATION", "entity_type": "organization", "organizat