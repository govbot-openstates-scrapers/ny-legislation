{"legislative_session": "2025-2026", "identifier": "A9106", "title": "Regulates the use of artificial intelligence in the provision of therapy or psychotherapy services", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "", "abstract": "Regulates the use of artificial intelligence in the provision of therapy or psychotherapy services by prohibiting the use of artificial intelligence to assist in providing supplementary support where the session is recorded or transcribed unless the patient is informed of the specific purpose of such use and consents of such use; establishes penalties for violations of such provisions; excludes religious counseling, peer-support, and self-help materials and educational resources from such provisions."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ny-2025_2026-a9106"}], "actions": [{"description": "REFERRED TO HIGHER EDUCATION", "date": "2025-09-26", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "HIGHER EDUCATION", "entity_type": "organization", "organization_id": null}]}, {"description": "REFERRED TO HIGHER EDUCATION", "date": "2026-01-07", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "HIGHER EDUCATION", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Jo Anne Simon", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Jo Anne Simon\"}", "organization_id": null}, {"name": "Phil Steck", "classification": "cosponsor", "entity_type": "person", "primary": false, "person_id": "~{\"name\": \"Phil Steck\"}", "organization_id": null}, {"name": "Yudelka Tapia", "classification": "cosponsor", "entity_type": "person", "primary": false, "person_id": "~{\"name\": \"Yudelka Tapia\"}", "organization_id": null